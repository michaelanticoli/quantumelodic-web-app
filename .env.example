# =============================================================================
# Quantumelodic – environment variables example
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- Vite / Frontend -----------------------------------------------------------

# Supabase project settings (required for auth and edge functions)
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# Backend API base URL (used by the UI's API client)
# Local dev: http://localhost:5001
# Production: https://your-api.render.com  (or wherever you deploy the backend)
VITE_API_BASE_URL=http://localhost:5001

# --- Flask / Python Backend ---------------------------------------------------

# Flask environment (development | production)
FLASK_ENV=development

# Port the Flask dev server listens on
PORT=5001

# Origin allowed by CORS (set to your Vite dev URL or production frontend URL)
FRONTEND_URL=http://localhost:8080

# --- Stripe (payments) --------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email provider -----------------------------------------------------------
# Configure ONE of the following providers.

# Option 1: SendGrid
# SENDGRID_API_KEY=SG.xxx

# Option 2: Mailgun
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.yourdomain.com

# Option 3: SMTP (e.g. Gmail, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# Sender identity (used by all email providers)
EMAIL_FROM=noreply@quantumelodic.com
EMAIL_FROM_NAME=Quantumelodic
